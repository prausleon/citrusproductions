# Dependencies — installed via composer/npm, not committed
/vendor
/node_modules

# Original v0.app Next.js export — reference only, not part of the theme
/_blueprint_source

# Build output — regenerated by `npm run build` / `npm run dev`
/public/*
!/public/.gitkeep

# Environment / local config
.env
.env.*
!.env.example

# Editor / IDE
.vscode
.idea
*.sublime-project
*.sublime-workspace

# OS cruft
.DS_Store
Thumbs.db

# Logs
npm-debug.log
yarn-error.log
*.log

# PHP tooling caches
.phpunit.result.cache
.php-cs-fixer.cache
